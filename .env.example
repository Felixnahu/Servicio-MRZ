# Servicio externo de respaldo (KYC). Copiar este archivo a .env y completar; .env NUNCA se versiona.
KYC_BASE_URL=
KYC_API_KEY=

# Opcionales (valores por defecto entre parentesis)
# OCR_THREADS=2          (hilos de ONNX; 0 = todos los nucleos, mucha mas CPU)
# AUTO_RECOGNITION=true  (false = solo lee al pedirlo: modo foto)
# CAMERA_ENABLED=true    (false = solo procesa fotos recibidas, sin abrir la camara)
# ADMIN_TOKEN=           (si se define, la calibracion exige la cabecera X-Admin-Token)
